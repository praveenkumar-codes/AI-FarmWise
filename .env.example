# AI FarmWise — Environment Configuration Example
# Copy this file to `server/.env` and fill in your optional API keys.
# Note: The platform includes deterministic fallbacks for all AI, weather, and hardware layers!

# LLM Reasoning Providers (Optional — falls back to deterministic agronomic reasoning if omitted)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (Defaults to SQLite in server/farmwise.db)
DATABASE_URL=sqlite:///./farmwise.db

# ESP32 Hardware & Edge Sensor Node Settings
ESP32_SERIAL_PORT=COM3
ESP32_BAUD_RATE=115200
ENABLE_SIMULATED_TELEMETRY=true

# Regional Coordinates Default (Guntur, Andhra Pradesh)
DEFAULT_LATITUDE=16.3067
DEFAULT_LONGITUDE=80.4365
